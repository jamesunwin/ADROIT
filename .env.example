# Optional paid assistance only; no keys are needed for deterministic physics.
# Copy ONCE to local .env (never committed); keep an existing .env.
# See docs/installation.md for official provider consoles and step-by-step setup.
# After obtaining a key, enter it only in .env for ADROIT. Never share it or paste
# it into code, notebooks, prompts, workbench fields, screenshots or Git.
# Keep .env private and out of shared/synced folders; it is plaintext, not encrypted.
# The SDK sends authentication to the selected provider over HTTPS on paid calls.
ANTHROPIC_API_KEY=

# Only for DM8's second, independent derivation (the checker, gpt-5.6-sol)
OPENAI_API_KEY=

# Optional model overrides (defaults: claude-sonnet-5, and claude-opus-4-8 for hard steps)
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_HARD=

# There is no process-wide offline switch (ADROIT_FAKE_LLM was retired in DM6): a paid command makes provider
# calls only within the budget you give it, and every other command is $0.

# Optional: relocate outputs, and cap the fitting process pool on shared machines
# ADROIT_RUNS_DIR=
# ADROIT_DATA_DIR=
# ADROIT_PROJECTS_DIR=
# ADROIT_MAX_WORKERS=
# ADROIT_TOOLS_DIR=      # where external tools are built; a path without spaces

# Optional: semantic retrieval embeddings (needs `uv sync --extra retrieval`)
# ADROIT_EMBEDDINGS=st
